# These are the default values pointing to the authoritative public release repo
# If you would like to pull updates from your own repo, you will need to re-define these values
#       and save this file as `.env` to override these defaults
#
# @see https://github.com/YahnisElsts/plugin-update-checker
POST_CONTENT_SHORTCODES_REPO_URL=https://github.com/cgrymala/post-content-shortcodes
POST_CONTENT_SHORTCODES_REPO_SLUG=post-content-shortcodes
POST_CONTENT_SHORTCODES_REPO_BRANCH=stable

# If you are using a private Bitbucket repo, you will need to define a consumer key and secret
# CORNELL_GOVERNANCE_REPO_CONSUMER_KEY=your-key-here
# CORNELL_GOVERNANCE_REPO_CONSUMER_SECRET=your-secret-here

# If you are using a private GitLab repo, you will need to set an authorization token
# CORNELL_GOVERNANCE_REPO_AUTH_TOKEN=your-token-here

# If you are using a custom/self-hosted GitLab server, you need to indicate that
# CORNELL_GOVERNANCE_REPO_IS_CUSTOM_GITLAB=true